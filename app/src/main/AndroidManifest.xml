<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.software.leanback" android:required="true" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <!-- 不画悬浮窗。只为让 RelaunchAfterUpdate 的 startActivity 通过后台启动限制:
         索尼固件不豁免默认桌面,悬浮窗权限(appops 授一次)是清单里剩下能用的豁免。 -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- M6/M7:传 APK 安装、检查更新后安装,都要走系统安装器 -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- M4 长按菜单「卸载」:API 26+ 起 ACTION_DELETE 需要它。
         没有这条时 startActivity **仍然返回成功**(系统卸载页确实起来了),
         但 UninstallerActivity 立刻以 "Uid … does not have android.permission.
         REQUEST_DELETE_PACKAGES" 结束 —— 连 toast 兜底都不会触发,用户按了毫无反应。 -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <!-- M6 上传服务(UploadServer,NanoHTTPD)要绑定/监听局域网端口:Android 上创建 AF_INET
         socket(含仅局域网、仅服务端的)一律要求这条权限,没有它 NetworkInterface.getNetworkInterfaces()
         拿到的地址列表就是空的、ServerSocket 也 bind 不了——2026-09-15 模拟器实测确认
         (加之前「导入图片」页固定显示「电视没有连接网络」,即使 eth0 明明有地址)。
         M6 设计文档 5 份任务简报都没提这条,是全计划遗漏,这里补上。 -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:label="@string/app_name"
        android:banner="@mipmap/banner"
        android:icon="@mipmap/banner"
        android:supportsRtl="false"
        android:theme="@style/Theme.TvHome">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:theme="@style/Theme.TvHome">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".RelaunchAfterUpdate"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- 应用被真正卸载后把它从 layout.json / titles.json 清掉;桌面进程不在时也要收得到,
             PACKAGE_FULLY_REMOVED 在隐式广播白名单里。系统广播,exported 必须为 true。 -->
        <receiver
            android:name=".PackageRemovedReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.PACKAGE_FULLY_REMOVED" />
                <data android:scheme="package" />
            </intent-filter>
        </receiver>

        <!-- 把 cacheDir/apk/ 里的 APK 以 content:// 交给系统安装器(file:// 自 API 24 起不允许) -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
